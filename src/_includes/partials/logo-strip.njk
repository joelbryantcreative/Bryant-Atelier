<section class="logos on-dark" id="trusted" aria-labelledby="trusted-label">
  <p class="eyebrow logos__label" id="trusted-label">Trusted by</p>
  <div class="marquee">
    <ul class="marquee__track" role="list">
      {%- for pass in [0, 1, 2, 3] %}{# 13 logos: four passes keep the loop seamless on wide screens #}
      {%- for c in clients %}
      <li{% if pass > 0 %} aria-hidden="true"{% endif %}><img src="/assets/logos/{{ c.file }}" alt="{% if pass == 0 %}{{ c.name }}{% endif %}" width="{{ c.w }}" height="{{ c.h }}" style="--h: {{ c.displayH }}px" loading="lazy" decoding="async"></li>
      {%- endfor %}
      {%- endfor %}
    </ul>
  </div>
</section>
