<form class="form" action="{{ site.formEndpoint }}" method="POST" data-contact-form>
  <input type="hidden" name="_subject" value="{{ site.reviewSubject }}">
  <input type="hidden" name="_captcha" value="true">
  <input type="hidden" name="_template" value="table">
  <input type="hidden" name="_next" value="{{ site.url }}/review/?sent=1">
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

  <fieldset class="field chips" data-offer-choice>
    <legend>Which would you like?</legend>
    <label class="chip"><input type="radio" name="offer" value="Free Content Review" data-offer="content" required checked><span>Content Review</span></label>
    <label class="chip"><input type="radio" name="offer" value="Free Story Session" data-offer="story"><span>Story Session</span></label>
    <label class="chip"><input type="radio" name="offer" value="Both" data-offer="both"><span>Both</span></label>
  </fieldset>
  <div class="form__row form__row--2">
    <div class="field"><label for="r-first">First Name</label><input id="r-first" name="firstname" type="text" required autocomplete="given-name"></div>
    <div class="field"><label for="r-last">Last Name</label><input id="r-last" name="lastname" type="text" required autocomplete="family-name"></div>
  </div>
  <div class="form__row form__row--2">
    <div class="field"><label for="r-email">Email Address</label><input id="r-email" name="email" type="email" required autocomplete="email" inputmode="email"></div>
    <div class="field"><label for="r-phone">Phone <span class="optional">(optional)</span></label><input id="r-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"></div>
  </div>
  <div class="form__row form__row--2">
    <div class="field"><label for="r-business">Business name</label><input id="r-business" name="business" type="text" required autocomplete="organization"></div>
    <div class="field"><label for="r-instagram">Instagram handle</label><input id="r-instagram" name="instagram" type="text" placeholder="@yourbusiness" autocapitalize="off" spellcheck="false"></div>
  </div>
  <div class="field"><label for="r-website">Website <span class="optional">(optional)</span></label><input id="r-website" name="website" type="url" inputmode="url" placeholder="https://"></div>
  <fieldset class="field chips">
    <legend>What do you want more of?</legend>
    {%- for opt in ["Enquiries", "Bookings", "Sales", "Brand awareness", "Not sure yet"] %}
    <label class="chip"><input type="checkbox" name="interest" value="{{ opt }}"><span>{{ opt }}</span></label>
    {%- endfor %}
  </fieldset>
  <div class="field"><label for="r-message">Anything I should know? <span class="optional">(optional)</span></label><textarea id="r-message" name="message" rows="4"></textarea></div>
  <div class="form__actions">
    <button class="btn btn--bone" type="submit">Send my request <span class="btn__arrow" aria-hidden="true">&rarr;</span></button>
    <p class="form__status" role="status" aria-live="polite" data-form-status></p>
  </div>
  <p class="form__note">Free, with no obligation. I'll reply within 48 hours. {% draft %}</p>
</form>
<div class="form-success" hidden tabindex="-1" data-form-success>
  <h3>Thanks, that's landed.</h3>
  <p>I'll be in touch within 48 hours. In the meantime, feel free to follow along on <a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a>. {% draft %}</p>
</div>
