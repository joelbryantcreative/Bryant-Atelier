<div class="contact">
  <div class="contact__details">
    <div class="book-card">
      <h3>Pick whichever is easiest</h3>
      <p class="muted">Fill in the form, send a text, or email me. {% draft %}</p>
      <div class="ways">
        <a class="btn btn--bone" href="{{ site.smsHref }}">Text {{ site.phoneLocal }}</a>
        <a class="btn btn--ghost" href="tel:{{ site.phoneHref }}">Call</a>
        <a class="btn btn--ghost" href="mailto:{{ site.email }}">Email me</a>
      </div>
      <p class="contact__direct">You'll speak with me directly, not a sales team. {% draft %}</p>
    </div>
    <div class="plan-check">
      <h3>Not ready to talk? <a href="{{ site.ctaUrl }}">Get your free video plan</a> {% draft %}</h3>
      <ul role="list">
        <li>Your story in one line, and how I'd film it</li>
        <li>3 short-form ideas for this month, with hooks</li>
        <li>What others in your industry do well</li>
        <li>What's holding your video back</li>
      </ul>
      <p class="muted" style="font-size: var(--fs-small)">Free, no obligation, within 2 business days.</p>
    </div>
    <dl>
      <div><dt>Email</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd></div>
      <div><dt>Phone</dt><dd><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></dd></div>
      <div><dt>Instagram</dt><dd><a href="{{ site.instagram }}" rel="noopener" target="_blank">{{ site.instagramHandle }}</a></dd></div>
      <div><dt>Areas served</dt><dd><ul class="areas" role="list">{% for a in site.areas %}<li>{{ a }}</li>{% endfor %}</ul></dd></div>
    </dl>
  </div>
  <div>{% include "partials/contact-form.njk" %}</div>
</div>
