<form class="form" action="{{ site.formEndpoint }}" method="POST" data-contact-form>
  <input type="hidden" name="_subject" value="{{ site.planSubject }}">
  <input type="hidden" name="_captcha" value="true">
  <input type="hidden" name="_template" value="table">
  <input type="hidden" name="_next" value="{{ site.url }}/free-video-plan/?sent=1">
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

  <div class="form__row form__row--2">
    <div class="field"><label for="p-first">First Name</label><input id="p-first" name="firstname" type="text" required autocomplete="given-name"></div>
    <div class="field"><label for="p-last">Last Name</label><input id="p-last" name="lastname" type="text" required autocomplete="family-name"></div>
  </div>
  <div class="form__row form__row--2">
    <div class="field"><label for="p-email">Email Address</label><input id="p-email" name="email" type="email" required autocomplete="email" inputmode="email"></div>
    <div class="field"><label for="p-phone">Phone <span class="optional">(optional)</span></label><input id="p-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"></div>
  </div>
  <div class="form__row form__row--2">
    <div class="field"><label for="p-business">Business name</label><input id="p-business" name="business" type="text" required autocomplete="organization"></div>
    <div class="field"><label for="p-instagram">Instagram handle <span class="optional">(if you have one)</span></label><input id="p-instagram" name="instagram" type="text" placeholder="@yourbusiness" autocapitalize="off" spellcheck="false"></div>
  </div>
  <div class="field"><label for="p-website">Website <span class="optional">(optional)</span></label><input id="p-website" name="website" type="url" inputmode="url" placeholder="https://"></div>
  <fieldset class="field chips">
    <legend>What are you most interested in? <span class="optional">(pick any)</span></legend>
    {%- for opt in ["A brand film or documentary", "Regular short-form content", "Ads that bring in customers", "Not sure yet"] %}
    <label class="chip"><input type="checkbox" name="interest" value="{{ opt }}"><span>{{ opt }}</span></label>
    {%- endfor %}
  </fieldset>
  <div class="field">
    <label for="p-budget">Rough budget for video in the next 6 months <span class="optional">(optional)</span></label>
    <select id="p-budget" name="budget">
      <option value="">Prefer not to say</option>
      <option>Under $2,000</option>
      <option>$2,000 to $5,000</option>
      <option>$5,000 to $10,000</option>
      <option>$10,000+</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div class="field"><label for="p-message">Anything we should know? <span class="optional">(optional)</span></label><textarea id="p-message" name="message" rows="4"></textarea></div>
  <div class="form__actions">
    <button class="btn btn--bone" type="submit">Send my request <span class="btn__arrow" aria-hidden="true">&rarr;</span></button>
    <p class="form__status" role="status" aria-live="polite" data-form-status></p>
  </div>
  <p class="form__note">Free, with no obligation. Your plan lands within 2 business days. {% draft %}</p>
</form>
<div class="form-success" hidden tabindex="-1" data-form-success>
  <h3>Thanks, that's landed.</h3>
  <p>We'll start on your plan and have it with you within 2 business days. In the meantime, feel free to follow along on <a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a>. {% draft %}</p>
</div>
