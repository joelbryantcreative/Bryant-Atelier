          <span class="win__laurels">{% for f in festivals %}<img src="/assets/laurels/{{ f.laurel }}" alt="{{ f.festival }}, {{ f.result }} {{ f.year }}" loading="lazy" decoding="async">{% endfor %}</span>
        </span>
        <span class="win__how"><strong>How:</strong> shot solo over two weeks on a remote stretch of coast. No crew, no budget.</span>
      </a>
      <a class="win" href="/work/bytropic-nutrition/">
        <span class="win__label">Brand film &amp; social</span>
        <span class="win__big">2 days</span>
        <span class="win__what">of filming became a whole campaign</span>
        <span class="win__how">A hero film, cut-downs for social and stills for the website. <strong>Bytropic Nutrition</strong></span>
      </a>
      <a class="win" href="/work/koud-the-breath-haus/">
