<section class="section on-light" id="faq" aria-labelledby="faq-h">
  <div class="container faq-wrap">
    <div class="section-head">
      <span class="eyebrow">08 / Common questions</span>
      <h2 id="faq-h">Good to know before you get in touch. {% draft %}</h2>
